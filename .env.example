# Local-only settings. Copy this file to .env and replace the password.
# Never share or commit your .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Hostinger Webmail SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=Operations@uruvelajourneys.com
EMAIL_HOST_PASSWORD=replace-with-your-hostinger-webmail-password
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Uruvela Journeys <Operations@uruvelajourneys.com>
SALES_EMAIL=Operations@uruvelajourneys.com
